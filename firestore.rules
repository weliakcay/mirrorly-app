rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isMerchantCreate(userId) {
      return isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role == "merchant"
        && request.resource.data.credits == 10
        && request.resource.data.status == "active";
    }

    function isMerchantSafeUpdate() {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.credits == resource.data.credits
        && request.resource.data.status == resource.data.status
        && request.resource.data.subscriptionTier == resource.data.subscriptionTier
        && request.resource.data.email == resource.data.email;
    }

    function isCustomerCreate(userId) {
      return isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role == "customer"
        && request.resource.data.credits == 3;
    }

    function isCustomerSafeUpdate() {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email
        && request.resource.data.credits == resource.data.credits
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /merchant_public/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    match /merchant_profiles/{userId} {
      allow read: if isOwner(userId);
      allow create: if isMerchantCreate(userId);
      allow update: if isOwner(userId) && isMerchantSafeUpdate();

      match /garments/{garmentId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }
    }

    match /{path=**}/garments/{garmentId} {
      allow read: if true;
    }

    match /customer_profiles/{userId} {
      allow read: if isOwner(userId);
      allow create: if isCustomerCreate(userId);
      allow update: if isOwner(userId) && isCustomerSafeUpdate();

      match /history/{historyId} {
        allow read, write: if isOwner(userId);
      }

      match /favorites/{favoriteId} {
        allow read, write: if isOwner(userId);
      }

      match /credit_transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }
  }
}
