rules_version = '2';

// Mirrorly Storage kuralları.
// İçerik: yalnızca merchant ürün görselleri + logoları (users/{uid}/garments|branding).
// Müşteri fotoğrafı ve try-on sonucu Firebase Storage'a YAZILMAZ (Kie'ye gider).
service firebase.storage {
  match /b/{bucket}/o {
    // Merchant kendi klasörü: herkes OKUR (ürün/logo görselleri müşteriye gösteriliyor),
    // yalnızca sahibi (giriş yapmış merchant) YAZAR. Boyut + tip kısıtı.
    match /users/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 6 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Başka her şey kapalı (test-mode açık-kapı riskini kapatır).
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
