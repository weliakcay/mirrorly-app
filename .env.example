# ─── Firebase (client / VITE_) ───────────────────────────────
VITE_FIREBASE_API_KEY=your_public_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:yourappid
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# live | demo  (demo = Kie'ye gitmeden watermark'li onizleme)
VITE_TRYON_MODE=live
# Admin paneli gorunum kapisi (server yetkisi ayri: set-admin custom claim)
VITE_ADMIN_EMAILS=admin@example.com
# Opsiyonel: Google tek-dokunus (GSI). Yoksa standart Google popup calisir.
VITE_GOOGLE_CLIENT_ID=
# Opsiyonel analytics
VITE_MIXPANEL_TOKEN=

# ─── Kie.ai ───────────────────────────────────────────────────
KIE_API_KEY=your_kie_api_key
# Aktif model (server/kie.js YALNIZ bunlari okur). family: flux-2 | nano-banana | gpt-image-2 | generic
KIE_MODEL_PRIMARY=flux-2/pro-image-to-image
KIE_MODEL_PRIMARY_FAMILY=flux-2
KIE_MODEL_PRIMARY_RESOLUTION=1K
KIE_MODEL_MARKET_FALLBACK=flux-2/flex-image-to-image
# (Google'in hizli modeli icin: KIE_MODEL_PRIMARY=nano-banana-2-lite + KIE_MODEL_PRIMARY_FAMILY=nano-banana)

# ─── Firebase Admin (server) ──────────────────────────────────
# Ya asagidaki split degiskenler, ya da tek JSON string olarak SERVICE_ACCOUNT_JSON.
FIREBASE_ADMIN_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON=

# ─── LemonSqueezy ödeme ───────────────────────────────────────
LEMON_SQUEEZY_WEBHOOK_SECRET=your_webhook_signing_secret
# ⚠️ KREDİ webhook'u YALNIZ variant_id'den kredi belirler. Bu ID'ler BOŞSA
# ödeme geldiginde kredi YUKLENMEZ (fail-safe). Prod'da hepsini doldur.
VITE_LS_CUSTOMER_STARTER_VARIANT_ID=
VITE_LS_CUSTOMER_STANDARD_VARIANT_ID=
VITE_LS_CUSTOMER_PLUS_VARIANT_ID=
VITE_LS_MERCHANT_STARTER_VARIANT_ID=
VITE_LS_MERCHANT_PRO_VARIANT_ID=
VITE_LS_MERCHANT_SCALE_VARIANT_ID=
LS_TOPUP_100_VARIANT_ID=
# Checkout URL override'lari (opsiyonel; yoksa billingService.ts varsayilanlari)
VITE_LS_CUSTOMER_PRODUCT_CHECKOUT_URL=
VITE_LS_MERCHANT_PRODUCT_CHECKOUT_URL=

# ─── Resend (opsiyonel e-posta) ───────────────────────────────
RESEND_API_KEY=
